{
  "name": "@aeondave/pi-skill-optimizer",
  "version": "3.1.2",
  "private": false,
  "type": "module",
  "description": "Less repeated context for Pi: local skill routing, on-demand tools, and recoverable output reduction.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "optimization",
    "tokens",
    "skills",
    "system-prompt",
    "tool-output",
    "mcp"
  ],
  "license": "MIT",
  "author": "AeonDave",
  "homepage": "https://github.com/AeonDave/pi-skill-optimizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AeonDave/pi-skill-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/AeonDave/pi-skill-optimizer/issues"
  },
  "engines": {
    "node": ">=26.3.0"
  },
  "files": [
    "src",
    "docs/ARCHITECTURE.md",
    "docs/CONFIGURATION.md",
    "docs/RANKING.md",
    "assets/banner.png",
    "README.md",
    "BENCHMARK.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/request.test.ts test/history.test.ts test/skills.test.ts test/skill-loader.test.ts test/tools.test.ts test/optimize.test.ts test/profile.test.ts test/activation.test.ts test/generate.test.ts test/init.test.ts test/init-readiness.test.ts test/config.test.ts test/fuzz.test.ts test/output.test.ts test/output-recovery.test.ts test/runtime.test.ts test/host-runtime.test.ts test/stats.test.ts test/usage.test.ts test/persistence.test.ts test/corpus.test.ts test/capture-catalog.test.ts test/evaluation.test.ts test/luna.test.ts test/release-metadata.test.ts",
    "measure": "node --import tsx scripts/measure.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "bench:perf": "node --import tsx scripts/perf-bench.ts",
    "bench:ranking": "node --import tsx scripts/ranking-bench.ts",
    "bench:output": "node --import tsx scripts/output-bench.ts",
    "smoke:blackbox": "node --import tsx scripts/black-box-smoke.ts",
    "corpus:build": "node --import tsx scripts/build-real-corpus.ts",
    "bench:real": "node --import tsx scripts/evaluate-real-corpus.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.13",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/AeonDave/pi-skill-optimizer/v3.1.2/assets/banner.png"
  }
}
